```gitignore
# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# Flask instance and local database
instance/
*.db
*.sqlite
*.sqlite3

# Uploaded files
uploads/

# IDE and editor
.vscode/

# Logs
*.log

# Test and coverage artifacts
.coverage
htmlcov/
```
